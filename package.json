{
  "name": "orbital-dispatcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "security:audit": "npm audit --audit-level=high",
    "security:secrets": "gitleaks git --pre-commit --redact --no-banner --exit-code 1 && gitleaks git --staged --redact --no-banner --exit-code 1 && gitleaks git --redact --no-banner --exit-code 1",
    "security:static": "semgrep scan --config p/javascript --config p/typescript --config p/php --error --metrics off --no-git-ignore src e2e server/app server/routes",
    "security:check": "npm run security:audit && npm run security:secrets && npm run security:static",
    "test:preview": "node --test e2e/preview.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
